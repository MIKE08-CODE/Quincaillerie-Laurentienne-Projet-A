# Copier en .env.development ou .env.production (jamais versionnés). Les variables EXPO_PUBLIC_* sont
# intégrées au code de l'application : elles sont PUBLIQUES. N'y mettez jamais de secret.

# Adresse de l'API (préfixe /api/v1 inclus).
#  - Émulateur Android : http://10.0.2.2:8000/api/v1
#  - Appareil réel sur le même réseau Wi-Fi : http://<adresse-IP-du-poste>:8000/api/v1
#  - API déployée : https://<hôte-de-l-api>/api/v1   (à compléter après le déploiement)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
