{
  "name": "quincaillerie-laurentienne-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "Application mobile client de Quincaillerie Laurentienne (Expo) — catalogue L1.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "doctor": "expo-doctor",
    "audit:check": "node scripts/audit-check.mjs"
  },
  "dependencies": {
    "expo": "58.0.26",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
