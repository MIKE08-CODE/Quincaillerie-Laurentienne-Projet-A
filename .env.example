# Copier ce fichier en .env et renseigner les valeurs locales.
# Ne jamais commiter de vraies valeurs.

# ----- API (FastAPI) -----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173

# ----- Authentification -----
# Clé Fernet pour chiffrer les secrets MFA. Générer avec :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# strict en local; none si le web et l'API sont sur deux domaines différents en production
REFRESH_COOKIE_SAMESITE=strict
PASSWORD_RESET_EXPIRE_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PRIVACY_POLICY_VERSION=1.0
WEB_BASE_URL=http://localhost:5173

# ----- Base de données (PostgreSQL) -----
POSTGRES_USER=quincaillerie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quincaillerie
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://quincaillerie:change-me@localhost:5432/quincaillerie

# ----- Web (Vite) : lues dans web/.env.local (voir web/.env.example) -----
# « /api/v1 » : même origine que le site, relayé vers l'API par Vite (dev) et par l'hébergeur (prod).
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8000

# ----- Mobile (Expo) : lue dans mobile/.env.development ou .env.production -----
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ----- Bureau (WPF) : appsettings.json, ou cette variable si elle est définie -----
QL_API_BASE_URL=http://localhost:8000/api/v1

# ----- RAG -----
LLM_API_KEY=
EMBEDDING_MODEL=
