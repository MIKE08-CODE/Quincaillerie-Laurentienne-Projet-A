{
  "name": "quincaillerie-laurentienne-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Application web bilingue de Quincaillerie Laurentienne (catalogue L1).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
