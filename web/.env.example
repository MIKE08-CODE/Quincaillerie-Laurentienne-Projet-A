# Copier en .env.local (jamais versionné). Aucune de ces valeurs n'est secrète : elles sont publiques
# dans le JavaScript livré au navigateur. Ne JAMAIS mettre de secret dans une variable VITE_*.

# Préfixe des appels à l'API. Par défaut « /api/v1 » : même origine que le site, relayé vers l'API
# par Vite en développement et par l'hébergeur en production.
VITE_API_BASE_URL=/api/v1

# Développement seulement : adresse de l'API FastAPI vers laquelle Vite relaie /api.
VITE_API_PROXY_TARGET=http://localhost:8000
